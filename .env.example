# Add a Resend API key to enable real server-side email delivery
# for the contact form. Without it the form falls back to opening
# the visitor's own mail client, so nothing is lost.
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_TO=hendra@synctrax.id

# The verified sender. Defaults to Resend's onboarding address.
# Verify your own domain in Resend for a custom "from".
CONTACT_FROM=
